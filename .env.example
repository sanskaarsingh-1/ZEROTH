# PowerShell: $env:CHAIN_ID="11155111"; npm start
PORT=3000
CHAIN_ID=11155111  # default chain; others selectable in the app
# Verified Aave V3 pool for the chosen chain; leave blank to disable lending transactions
AAVE_POOL=
# JSON map symbol to verified address + decimals; example {"USDC":{"address":"0x...","decimals":6}}
TOKENS_JSON={}  # or per chain: {"1":{"USDC":{"address":"0x...","decimals":6}}}
# Optional 0x API key; ensure supported chain
ZEROX_API_KEY=
TOKEN_FACTORY=
